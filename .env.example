# Deployment mode: "self-hosted" or "cloud"
CHYTR_MODE=self-hosted

# Dev mode: skip license gate entirely, runs as team tier (local dev only, never production)
CHYTR_DEV_MODE=false

# Supabase (local when self-hosted, hosted when cloud)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: direct DB URL for running migrations (Dashboard → Database → Connection string → URI)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# License key (self-hosted only — get one at https://www.chytr.ai/register)
CHYTR_LICENSE_KEY=

# chytr API key (authenticates hooks, users, integrations; also used as Cursor webhook secret)
# Generate from Settings -> API Keys (prefix: chk_...)
CHYTR_API_KEY=

# Public URL of this chytr instance (required for webhooks and hooks)
# Example: https://app.chytr.ai or http://localhost:3000
CHYTR_PUBLIC_URL=

# Cursor API key (for launching Cloud Agents)
CURSOR_API_KEY=

# GitHub token (for repo access)
GITHUB_TOKEN=

# Approval routing (optional)
SLACK_WEBHOOK_URL=
AGENTMAIL_API_KEY=

# Hooks config
# Hooks auto-source .env.local; if CHYTR_URL/CHYTR_API_KEY are missing they exit silently.
# CHYTR_URL=              # override if different from CHYTR_PUBLIC_URL
# CHYTR_REPO=             # override auto-detected git remote (optional)
# CHYTR_HOOK_DEBUG=1      # log hook runs and curl responses to .cursor/hooks/debug.log

# License JWT signing (RS256 key pair)
CHYTR_PRIVATE_KEY=
CHYTR_PUBLIC_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
